{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PodcastGenerated",
  "type": "object",
  "required": ["eventType", "version", "podcastId", "filePath", "durationSecs", "ts"],
  "properties": {
    "eventType":    { "type": "string", "const": "PodcastGenerated" },
    "version":      { "type": "string", "const": "1.0" },
    "podcastId":    { "type": "string", "format": "uuid" },
    "filePath":     { "type": "string" },
    "durationSecs": { "type": "number", "minimum": 0 },
    "ts":           { "type": "string", "format": "date-time" }
  }
}
